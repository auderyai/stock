# PostgreSQL only
KRX_DB_ENGINE=postgresql
KRX_DB_HOST=127.0.0.1
KRX_DB_PORT=5432
KRX_DB_NAME=krx_research

# KRX_DB_USER is optional.
# If omitted, new_stock uses the existing PostgreSQL writer role: krx_writer.
# KRX_DB_USER=krx_writer

# Existing password key used by the current workstation.
# KRX_DB_WRITE_PASSWORD=
