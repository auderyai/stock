# new_stock is PostgreSQL-only. Copy existing credentials from C:\stock\.env.
KRX_DB_ENGINE=postgresql
KRX_DB_HOST=127.0.0.1
KRX_DB_PORT=5432
KRX_DB_NAME=krx_research
KRX_DB_READ_USER=
KRX_DB_READ_PASSWORD=
KRX_DB_WRITE_USER=
KRX_DB_WRITE_PASSWORD=
KRX_DB_CONNECT_TIMEOUT=10
KRX_DB_STATEMENT_TIMEOUT=120
KRX_DB_SSL_MODE=prefer
KRX_DB_SSL_CA=
KRX_DB_DUMP=pg_dump
DART_API_KEY=
GEMINI_API_KEY=

# LS OPEN API (keep real values only in .env; .env is gitignored)
LS_APP_KEY=
LS_APP_SECRET=
